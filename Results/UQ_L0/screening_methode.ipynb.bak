    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "n = 400 (testbig):\n",
      "Modell           Shapiro W      p-Wert      Normalität\n",
      "mace-L0-01          0.9930    6.09e-02 nicht verworfen\n",
      "mace-L0-c-01        0.9959    3.80e-01 nicht verworfen\n",
