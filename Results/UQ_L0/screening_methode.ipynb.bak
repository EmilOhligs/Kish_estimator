    "# dasselbe auf dem grossen Satz (n=5000, bereinigt) — SEPARATER Plot neben dem 400er\n",
    "show_full = {\"mace-L0-01\": \"firebrick\", \"mace-L0-c-01\": \"darkorange\",\n",
